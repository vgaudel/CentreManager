<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.application.Application?> <!-- généralement pas nécessaire dans FXML -->
<?import javafx.fxml.FXML?> <!-- annotations, pas besoin dans FXML -->
<?import javafx.fxml.FXMLLoader?> <!-- pour charger le FXML, pas nécessaire dans FXML -->

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.*?> <!-- pour tous les autres controls comme TextField, CheckBox etc. -->
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.collections.FXCollections?> <!-- collections, pas forcément utile dans FXML -->

<?import javafx.scene.input.MouseEvent?> <!-- événements, pas utilisé dans FXML -->
<?import javafx.event.ActionEvent?> <!-- idem -->

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="900.0" prefHeight="600.0" fx:controller="fr.dawan.CenterManager.controller.TreeController">

    <!-- MenuBar en haut -->
    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="New"/>
                        <MenuItem text="Open…"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Save"/>
                        <MenuItem text="Quit"/>
                    </items>
                </Menu>
                <Menu text="Edit">
                    <items>
                        <MenuItem text="Undo"/>
                        <MenuItem text="Redo"/>
                    </items>
                </Menu>
                <Menu text="Help">
                    <items>
                        <MenuItem text="About MyHelloApp"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <!-- SplitPane principal -->
        <SplitPane dividerPositions="0.25" VBox.vgrow="ALWAYS">
            <items>
                <!-- Colonne gauche : ListView des éléments -->
                <AnchorPane prefWidth="200.0">
                    <children>
                        <VBox layoutX="5" layoutY="5" spacing="10.0">
                            <Label text="Éléments disponibles:"/>
                            <!-- <ListView fx:id="elementsList" prefWidth="180.0" prefHeight="500.0"/> -->
                            <TreeView fx:id="menuTree" prefWidth="200.0" showRoot="false"/>
                        </VBox>
                    </children>
                </AnchorPane>

                <!-- Colonne droite : plan scrollable -->
                <ScrollPane prefWidth="700.0">
                    <content>
                        <AnchorPane fx:id="planContent" prefWidth="700.0" prefHeight="550.0">
                            <children>
                              <!-- On met le plan dans un StackPane pour gérer le centrage -->
                              <StackPane prefWidth="430.0" prefHeight="545.0">
                                  <!-- Ici ton plan (ImageView, SVG, etc.) -->
                                  <ImageView fx:id="planImage" fitWidth="400" fitHeight="400" preserveRatio="true" />

                                  <!-- Bouton centré -->
                                  <Button text="Ajouter étiquette" />
                              </StackPane>
                            </children>
                        </AnchorPane>
                    </content>
                </ScrollPane>
            </items>
        </SplitPane>

        <!-- Barre de status en bas -->
        <HBox spacing="5.0" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
            <padding>
                <Insets top="3" right="3" bottom="3" left="3"/>
            </padding>
            <children>
                <Label text="Left status" HBox.hgrow="ALWAYS"/>
                <Pane HBox.hgrow="ALWAYS"/> <!-- juste pour espacer -->
                <Label text="Right status"/>
            </children>
        </HBox>
    </children>
</VBox>
